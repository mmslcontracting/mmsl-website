---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import CTA from "@/components/CTA.astro";
---

<Layout>
  <Header />
  
  <main>
    <!-- Hero Section -->
    <section class="py-16 first-section" style="background-color:var(--color-surface)">
      <div class="max-w-7xl mx-auto px-6 text-center">
        <h1 class="text-4xl md:text-5xl font-serif text-gray-900">Contact Us</h1>
        <p class="mt-4 text-gray-600 max-w-2xl mx-auto">
          Ready to transform your space? Get in touch with our team — we serve New Jersey, Boston, and New York.
        </p>
      </div>
    </section>

    <!-- Contact Form & Info Section -->
    <section class="py-16 bg-white">
      <div class="max-w-7xl mx-auto px-6">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
          <!-- Left: Contact Form -->
          <div>
            <h2 class="text-2xl font-serif text-gray-900 mb-6">Send us a message</h2>
            <form class="space-y-6">
              <div>
                <label for="name" class="block text-sm font-medium text-gray-700 mb-2">Full Name</label>
                <input type="text" id="name" name="name" required class="w-full px-4 py-3 border border-gray-300 rounded-none focus:outline-none focus:border-black" placeholder="John Doe">
              </div>

              <div>
                <label for="email" class="block text-sm font-medium text-gray-700 mb-2">Email Address</label>
                <input type="email" id="email" name="email" required class="w-full px-4 py-3 border border-gray-300 rounded-none focus:outline-none focus:border-black" placeholder="john@example.com">
              </div>

              <div>
                <label for="phone" class="block text-sm font-medium text-gray-700 mb-2">Phone Number</label>
                <input type="tel" id="phone" name="phone" class="w-full px-4 py-3 border border-gray-300 rounded-none focus:outline-none focus:border-black" placeholder="(555) 555-5555">
              </div>

              <div>
                <label for="location" class="block text-sm font-medium text-gray-700 mb-2">Project Location</label>
                <select id="location" name="location" class="w-full px-4 py-3 border border-gray-300 rounded-none focus:outline-none focus:border-black">
                  <option value="">Select a location</option>
                  <option value="NJ">New Jersey</option>
                  <option value="Boston">Boston</option>
                  <option value="NY">New York</option>
                </select>
              </div>

              <div>
                <label for="message" class="block text-sm font-medium text-gray-700 mb-2">Message</label>
                <textarea id="message" name="message" rows="5" required class="w-full px-4 py-3 border border-gray-300 rounded-none focus:outline-none focus:border-black" placeholder="Tell us about your project..."></textarea>
              </div>

              <button type="submit" class="w-full px-6 py-3 bg-black text-white rounded-none font-medium hover:bg-gray-800 transition">Send Message</button>
            </form>
          </div>

          <!-- Right: Contact Info & Map -->
          <div>
            <h2 class="text-2xl font-serif text-gray-900 mb-6">Get in touch</h2>
            
            <div class="space-y-6 mb-8">
              <div>
                <h3 class="font-semibold text-gray-900 mb-2">Phone</h3>
                <p class="text-gray-600"><a href="tel:+1-555-555-5555" class="hover:underline">(555) 555-5555</a></p>
              </div>

              <div>
                <h3 class="font-semibold text-gray-900 mb-2">Email</h3>
                <p class="text-gray-600"><a href="mailto:hello@mms.com" class="hover:underline">hello@mms.com</a></p>
              </div>

              <div>
                <h3 class="font-semibold text-gray-900 mb-2">Service Areas</h3>
                <p class="text-gray-600">New Jersey, Boston, New York</p>
              </div>

              <div>
                <h3 class="font-semibold text-gray-900 mb-2">Business Hours</h3>
                <p class="text-gray-600">Monday - Friday: 8am - 6pm<br>Saturday: 9am - 4pm<br>Sunday: Closed</p>
              </div>
            </div>

            <!-- Google Maps Embed -->
            <div class="w-full h-80 rounded-none overflow-hidden border border-gray-300">
              <iframe 
                src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3022.1841288959347!2d-73.98784368459395!3d40.758895979327456!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x89c25855c6480299%3A0x55194ec5a1ae072e!2sTimes%20Square!5e0!3m2!1sen!2sus!4v1234567890123!5m2!1sen!2sus" 
                width="100%" 
                height="100%" 
                style="border:0;" 
                allowfullscreen="" 
                loading="lazy" 
                referrerpolicy="no-referrer-when-downgrade"
                title="MMS Home Paint Location"
              ></iframe>
            </div>
          </div>
        </div>
      </div>
    </section>

    <CTA />
  </main>
</Layout>
