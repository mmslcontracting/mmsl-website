---
import Layout from '@/layouts/Layout.astro'
import Header from '@/components/Header.astro'
import CTA from '@/components/CTA.astro'
---

<Layout>
  <Header />

  <!-- Hero Section -->
  <section class="first-section py-16" style="background-color:var(--color-surface)">
    <div class="mx-auto max-w-7xl px-6 text-center">
      <h1 class="font-serif text-4xl text-gray-900 md:text-5xl">Contact Us</h1>
      <p class="mx-auto mt-4 max-w-2xl text-gray-600">
        Ready to transform your space? Get in touch with our team — we serve New York City · North
        Jersey · Central Jersey.
      </p>
    </div>
  </section>

  <!-- Contact Form & Info Section -->
  <section class="bg-white py-16">
    <div class="mx-auto max-w-7xl px-6">
      <div class="grid grid-cols-1 gap-12 lg:grid-cols-2">
        <!-- Left: Contact Form -->
        <div>
          <h2 class="mb-6 font-serif text-2xl text-gray-900">Send us a message</h2>
          <form class="space-y-6">
            <div>
              <label for="name" class="mb-2 block text-sm font-medium text-gray-700"
                >Full Name</label
              >
              <input
                type="text"
                id="name"
                name="name"
                required
                class="w-full rounded-none border border-gray-300 px-4 py-3 focus:border-black focus:outline-none"
                placeholder="John Doe"
              />
            </div>

            <div>
              <label for="email" class="mb-2 block text-sm font-medium text-gray-700"
                >Email Address</label
              >
              <input
                type="email"
                id="email"
                name="email"
                required
                class="w-full rounded-none border border-gray-300 px-4 py-3 focus:border-black focus:outline-none"
                placeholder="john@example.com"
              />
            </div>

            <div>
              <label for="phone" class="mb-2 block text-sm font-medium text-gray-700"
                >Phone Number</label
              >
              <input
                type="tel"
                id="phone"
                name="phone"
                class="w-full rounded-none border border-gray-300 px-4 py-3 focus:border-black focus:outline-none"
                placeholder="(555) 555-5555"
              />
            </div>

            <div>
              <label for="location" class="mb-2 block text-sm font-medium text-gray-700"
                >Project Location</label
              >
              <select
                id="location"
                name="location"
                class="w-full rounded-none border border-gray-300 px-4 py-3 focus:border-black focus:outline-none"
              >
                <option value="">Select a location</option>
                <option value="NYC">New York City</option>
                <option value="NJ">North Jersey</option>
                <option value="CJ">Central Jersey</option>
              </select>
            </div>

            <div>
              <label for="message" class="mb-2 block text-sm font-medium text-gray-700"
                >Message</label
              >
              <textarea
                id="message"
                name="message"
                rows="5"
                required
                class="w-full rounded-none border border-gray-300 px-4 py-3 focus:border-black focus:outline-none"
                placeholder="Tell us about your project..."></textarea>
            </div>

            <button type="submit" class="btn-primary btn-lg w-full"> Send Message </button>
          </form>
        </div>

        <!-- Right: Contact Info & Map -->
        <div>
          <h2 class="mb-6 font-serif text-2xl text-gray-900">Get in touch</h2>

          <div class="mb-8 space-y-6">
            <div>
              <h3 class="mb-2 font-semibold text-gray-900">Phone</h3>
              <p class="text-gray-600">
                <a href="tel:+1-631-805-6259" class="hover:underline">(631) 805-6259</a>
              </p>
            </div>

            <div>
              <h3 class="mb-2 font-semibold text-gray-900">Email</h3>
              <p class="text-gray-600">
                <a href="mailto:hello@mms.com" class="hover:underline"
                  >mmshomeimprovement@gmail.com</a
                >
              </p>
            </div>

            <div>
              <h3 class="mb-2 font-semibold text-gray-900">Service Areas</h3>
              <p class="text-gray-600">New York City · North Jersey · Central Jersey</p>
            </div>

            <div>
              <h3 class="mb-2 font-semibold text-gray-900">Business Hours</h3>
              <p class="text-gray-600">Monday - Friday: 8am - 5pm</p>
            </div>
          </div>

          <!-- Google Maps Embed -->
          <div class="h-80 w-full overflow-hidden rounded-none border border-gray-300">
            <iframe
              src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2910.303490185106!2d-73.8033387242696!3d40.706782437935516!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x89c260de801aaaab%3A0x75bca1a79b3dfcbd!2s88-44%20161st%20St%2C%20Jamaica%2C%20NY%2011432%2C%20EE.%20UU.!5e1!3m2!1ses!2sec!4v1764022189990!5m2!1ses!2sec"
              width="100%"
              height="100%"
              style="border:0;"
              allowfullscreen=""
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              title="MMS Home Paint Location"></iframe>
          </div>
        </div>
      </div>
    </div>
  </section>

  <CTA />
</Layout>
