---
import Layout from '@/layouts/Layout.astro'

const heroImage = '/images/portfolio/interior/1.jpeg'
const storyParagraphs = [
  'For over a decade, we have translated architectural intent into deeply personal interiors across New Jersey, Boston, and New York. Our work balances heritage craftsmanship with contemporary fluidity, making each space feel curated yet lived-in.',
  'We are a collective of designers, artisans, and builders who thrive on solving layered spatial challenges. From concept studies to the final punch list, we keep the dialogue transparent and the process purposeful.',
]

const stats = [
  { label: 'Years crafting interiors', value: '15+' },
  { label: 'Projects completed', value: '500+' },
  { label: 'Awards & honors', value: '12' },
]

const values = [
  {
    title: 'Thoughtful Materials',
    copy: 'We source stone, wood, and textiles that age gracefully and feel attuned to your lifestyle.',
  },
  {
    title: 'Human-Centered Design',
    copy: 'Rooms that anticipate how families gather, rest, entertain, and retreat.',
  },
  {
    title: 'Transparent Process',
    copy: 'Budget, timeline, and decisions are shared so you feel confident from day one.',
  },
]

const timeline = [
  { title: 'Discovery', copy: 'Listening tours, site walks, and research.' },
  { title: 'Design', copy: 'Mood, material palettes, and architectural detailing.' },
  { title: 'Build', copy: 'Construction oversight and craft-driven finishing.' },
  { title: 'Refine', copy: 'Styling, installation, and thoughtful hand-offs.' },
]
---

<Layout>
  <section class="relative overflow-hidden bg-black text-white first-section">
    <div class="absolute inset-0 opacity-80">
      <img src={heroImage} alt="Design studio" class="h-full w-full object-cover" loading="lazy" />
      <div class="absolute inset-0 bg-linear-to-b from-black/80 via-black/70 to-black/95"></div>
    </div>
    <div class="relative z-10 flex min-h-[70vh] flex-col items-center justify-center px-6 py-24 text-center">
      <p class="text-xs uppercase tracking-[0.5em] text-white/60">About us</p>
      <h1 class="mt-6 max-w-3xl font-serif text-4xl font-semibold leading-tight md:text-5xl">
        Interiors with a quiet confidence and a distinctly American sensibility.
      </h1>
      <p class="mt-6 max-w-2xl text-lg text-white/80">
        We partner with homeowners, developers, and architects to craft spaces that feel intimate yet expansive,
        layered with texture, warmth, and curated light.
      </p>
    </div>
  </section>

  <section class="bg-surface py-16">
    <div class="container mx-auto px-6">
      <div class="grid gap-10 lg:grid-cols-[1.2fr_0.8fr]">
        <div>
          <p class="text-sm uppercase tracking-[0.4em] text-gray-500">Our Story</p>
          <h2 class="mt-4 font-serif text-4xl font-semibold text-gray-900">We build with intention</h2>
          <div class="mt-6 space-y-5 text-gray-600">
            {storyParagraphs.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </div>
        </div>
        <div class="rounded-3xl border border-gray-200 bg-white p-8 shadow-lg">
          <div class="mb-6 text-sm uppercase tracking-[0.4em] text-gray-500">Milestones</div>
          <div class="grid gap-6">
            {stats.map((stat) => (
              <div class="flex flex-col gap-1 text-gray-700">
                <span class="text-3xl font-semibold text-black">{stat.value}</span>
                <span class="text-sm uppercase tracking-[0.3em] text-gray-500">{stat.label}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-white py-16">
    <div class="container mx-auto px-6">
      <div class="grid gap-10 lg:grid-cols-3">
        {values.map((value) => (
          <article class="rounded-3xl border border-gray-200 bg-[#fefefe] p-8 shadow-sm">
            <h3 class="font-serif text-2xl font-semibold text-gray-900">{value.title}</h3>
            <p class="mt-4 text-sm text-gray-600">{value.copy}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-black text-white">
    <div class="container mx-auto px-6 py-16">
      <div class="grid gap-10 lg:grid-cols-4">
        {timeline.map((step) => (
          <div>
            <span class="text-xs uppercase tracking-[0.4em] text-white/60">{step.title}</span>
            <p class="mt-3 max-w-sm text-sm text-white/80">{step.copy}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-surface py-16">
    <div class="container mx-auto px-6 text-center">
      <p class="text-sm uppercase tracking-[0.5em] text-gray-500">Connect</p>
      <h3 class="mt-4 font-serif text-3xl font-semibold text-gray-900">Ready to start a project?</h3>
      <p class="mx-auto mt-4 max-w-2xl text-sm text-gray-600">
        Share your vision and we will respond with a thoughtful outline of the first steps, mood exploration, and
        a proposed timeline.
      </p>
      <a
        href="/contact"
        class="mt-8 inline-flex items-center justify-center rounded-full border border-black px-10 py-3 text-sm font-semibold uppercase tracking-[0.3em] text-black transition hover:bg-black hover:text-white"
      >
        Schedule a call
      </a>
    </div>
  </section>
</Layout>
