---
import CTA from '@/components/CTA.astro'
import Layout from '@/layouts/Layout.astro'
import { Image } from 'astro:assets'

const seo = {
  title: 'About Us',
  description:
    'Family-owned renovation company serving NYC & NJ. Quality craftsmanship and customer satisfaction.',
  keywords: [
    'about MMSL Contracting',
    'painting company history',
    'family painting business',
    'NYC painters',
    'New Jersey painting contractors',
  ],
}

const heroImage = '/images/portfolio/interior/1.jpeg'

const timeline = [
  { title: 'Discovery', copy: 'Listening tours, site walks, and research.' },
  { title: 'Design', copy: 'Mood, material palettes, and architectural detailing.' },
  { title: 'Build', copy: 'Construction oversight and craft-driven finishing.' },
  { title: 'Refine', copy: 'Styling, installation, and thoughtful hand-offs.' },
]
---

<Layout title={seo.title} description={seo.description} keywords={seo.keywords}>
  <section class="first-section relative overflow-hidden bg-black text-white">
    <div class="absolute inset-0 opacity-80">
      <Image
        width={1200}
        height={1600}
        src={heroImage}
        alt="Design studio"
        class="h-full w-full object-cover"
        loading="eager"
        fetchpriority="high"
      />
      <div class="absolute inset-0 bg-linear-to-b from-black/70 via-black/60 to-black/80"></div>
    </div>
    <div
      class="relative z-10 flex min-h-[70vh] flex-col items-center justify-center px-6 py-24 text-center"
    >
      <p class="text-xs tracking-[0.5em] text-white/60 uppercase">About us</p>
      <h1
        class="animate-fade-up mt-6 max-w-3xl font-serif text-4xl leading-tight font-semibold md:text-5xl"
      >
        Get to <span class="text-gradient-gold">know</span> us
      </h1>
      <p class="mt-6 max-w-2xl text-lg text-white/80">Learn more about MMSL Contracting.</p>
    </div>
  </section>

  <section class="bg-surface py-16">
    <div class="container mx-auto px-6">
      <div class="grid gap-10 lg:grid-cols-[1.2fr_0.8fr]">
        <div>
          <p class="text-sm tracking-[0.4em] uppercase">
            <span class="text-gradient-gold">Our Story</span>
          </p>
          <h2 class="mt-4 font-serif text-4xl font-semibold text-gray-900">
            We build with intention
          </h2>
          <div class="prose mt-6 space-y-5 text-gray-600">
            <p class="intersect:visible intersect:animate-fade-up invisible">
              This is how it all started: nature has all the components that form a dream harmony,
              making us enjoy unique experiences that we never dreamed of living.
            </p>
            <p class="intersect:visible intersect:animate-fade-up animate-delay-300 invisible">
              At MMSL Contracting, our dream and goal is that our customers have a space where they
              can enjoy with their love ones. We can transform their spaces in harmony with all the
              components in a complete interior renovation or make a cosmetic update.
            </p>
            <p class="intersect:visible intersect:animate-fade-up animate-delay-600 invisible">
              The name of our MMS firm is derived from the initials of each member of my family,
              which remind us of the commitment we make in every project. We take it as a family
              project, forming part of every dream that comes true for our customers.
            </p>
          </div>
        </div>
        <div class="h-[350px] overflow-hidden md:h-[400px]">
          <Image
            src="/images/about/history.jpeg"
            alt="MMSL Contracting family team"
            width={600}
            height={400}
            class="h-full w-auto rounded-md object-contain shadow-md"
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </section>

  <section class="bg-white py-16">
    <div class="container mx-auto px-6">
      <div class="rounded-3xl border border-gray-200 bg-[#fefefe] p-10 shadow-lg">
        <p class="text-lg text-gray-800">
          Our mission at MMSL Contracting Corp is simple: to provide high-quality services in a timely manner.
          Our team caters to each project’s specific needs to ensure excellence. We hope you’ll find
          what you’re looking for. For more information or general inquiries, feel free to get in
          touch today.
        </p>
      </div>
    </div>
  </section>

  <section class="bg-black text-white">
    <div class="container mx-auto px-6 py-16">
      <div class="grid gap-10 lg:grid-cols-4">
        {
          timeline.map((step, index) => (
            <div
              class={`intersect-full intersect-once ${index <= 1 ? 'intersect:animate-fade-right' : 'intersect:animate-fade-left'}`}
            >
              <h3 class="text-gradient-gold font-sans! text-xs tracking-[0.4em] uppercase">
                {step.title}
              </h3>
              <p class="mt-3 max-w-sm text-sm text-white/80">{step.copy}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <CTA />
</Layout>
