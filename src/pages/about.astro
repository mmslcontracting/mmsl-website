---
import CTA from '@/components/CTA.astro'
import Layout from '@/layouts/Layout.astro'
import { Image } from 'astro:assets'

const seo = {
  title: 'About Us - Our Story & Mission',
  description:
    'Learn about MMS Home Paint, a family-owned painting company serving NYC and New Jersey for over a decade. Discover our commitment to quality craftsmanship and customer satisfaction.',
  keywords: [
    'about MMS Home Paint',
    'painting company history',
    'family painting business',
    'NYC painters',
    'New Jersey painting contractors',
  ],
}

const heroImage = '/images/portfolio/interior/1.jpeg'
const storyParagraphs = [
  'For over a decade, we have translated architectural intent into deeply personal interiors across New York City · North Jersey · Central Jersey. Our work balances heritage craftsmanship with contemporary fluidity, making each space feel curated yet lived-in.',
  'We are a collective of designers, artisans, and builders who thrive on solving layered spatial challenges. From concept studies to the final punch list, we keep the dialogue transparent and the process purposeful.',
]

const timeline = [
  { title: 'Discovery', copy: 'Listening tours, site walks, and research.' },
  { title: 'Design', copy: 'Mood, material palettes, and architectural detailing.' },
  { title: 'Build', copy: 'Construction oversight and craft-driven finishing.' },
  { title: 'Refine', copy: 'Styling, installation, and thoughtful hand-offs.' },
]
---

<Layout title={seo.title} description={seo.description} keywords={seo.keywords}>
  <section class="first-section relative overflow-hidden bg-black text-white">
    <div class="absolute inset-0 opacity-80">
      <Image
        width={1200}
        height={1600}
        src={heroImage}
        alt="Design studio"
        class="h-full w-full object-cover"
        loading="lazy"
      />
      <div class="absolute inset-0 bg-linear-to-b from-black/70 via-black/60 to-black/80"></div>
    </div>
    <div
      class="relative z-10 flex min-h-[70vh] flex-col items-center justify-center px-6 py-24 text-center"
    >
      <p class="text-xs tracking-[0.5em] text-white/60 uppercase">About us</p>
      <h1 class="mt-6 max-w-3xl font-serif text-4xl leading-tight font-semibold md:text-5xl">
        Get to <span class="text-gradient-primary">know</span> us
      </h1>
      <p class="mt-6 max-w-2xl text-lg text-white/80">Learn more about MMS Paint.</p>
    </div>
  </section>

  <section class="bg-surface py-16">
    <div class="container mx-auto px-6">
      <div class="grid gap-10 lg:grid-cols-[1.2fr_0.8fr]">
        <div>
          <p class="text-sm tracking-[0.4em] text-gray-500 uppercase">Our Story</p>
          <h2 class="mt-4 font-serif text-4xl font-semibold text-gray-900">
            We build with intention
          </h2>
          <div class="mt-6 space-y-5 text-gray-600">
            <p>
              This is how it all started: nature has all the components that form a dream harmony,
              making us enjoy unique experiences that we never dreamed of living. At MMS Paint &
              Home Improvement Corp, our dream and goal is that our customers have a space where
              they can enjoy with their love ones. We can transform their spaces in harmony with all
              the components in a complete interior renovation or make a cosmetic update. The name
              of our MMS firm is derived from the initials of each member of my family, which remind
              us of the commitment we make in every project. We take it as a family project, forming
              part of every dream that comes true for our customers.
            </p>
          </div>
        </div>
        <div class="rounded-3xl">
          <div class="grid gap-6">
            <Image
              src="/images/about/history.jpeg"
              alt="MMS Paint family team"
              width={600}
              height={400}
              class="h-full w-full rounded-sm object-cover"
              loading="lazy"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-white py-16">
    <div class="container mx-auto px-6">
      <div class="rounded-3xl border border-gray-200 bg-[#fefefe] p-10 shadow-lg">
        <p class="text-lg text-gray-800">
          Our mission at MMS-HOME is simple: to provide high-quality services in a timely manner.
          Our team caters to each project’s specific needs to ensure excellence. We hope you’ll find
          what you’re looking for. For more information or general inquiries, feel free to get in
          touch today.
        </p>
      </div>
    </div>
  </section>

  <section class="bg-black text-white">
    <div class="container mx-auto px-6 py-16">
      <div class="grid gap-10 lg:grid-cols-4">
        {
          timeline.map((step) => (
            <div>
              <span class="text-xs tracking-[0.4em] text-white/60 uppercase">{step.title}</span>
              <p class="mt-3 max-w-sm text-sm text-white/80">{step.copy}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <CTA />
</Layout>
