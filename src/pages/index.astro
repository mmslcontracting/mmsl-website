---
import Layout from '@/layouts/Layout.astro'
import Hero from '@/components/Hero.astro'
import PortfolioPreview from '@/components/PortfolioPreview.astro'
import RecentProject from '@/components/RecentProject.astro'
import Services from '@/components/Services.astro'
import ComingSoon from '@/components/ComingSoon.astro'
import CTA from '@/components/CTA.astro'

const seo = {
  title: 'Home Renovation & Remodeling in NYC & NJ',
  description:
    'MMSL Contracting Corp — Premium home renovation & remodeling in NYC & NJ. Kitchens, bathrooms, interiors, exteriors & more.',
  keywords: [
    'painting services NYC',
    'house painting New Jersey',
    'interior painting',
    'exterior painting',
    'commercial painter',
    'residential painting',
    'cabinet refinishing',
    'MMSL Contracting Corp',
    'MMSL Contracting',
  ],
}
---

<Layout title={seo.title} description={seo.description} keywords={seo.keywords}>
  <Hero />
  <RecentProject />
  <Services />
  <PortfolioPreview />
  <ComingSoon />
  <CTA />
</Layout>
