---
import Layout from '@/layouts/Layout.astro'
import PortfolioGallery from '@/components/PortfolioGallery'

const heroImage = '/images/portfolio/wallpaper.jpeg'
---

<Layout>
  <section class="relative min-h-screen overflow-hidden bg-black text-white">
    <div class="absolute inset-0">
      <img
        src={heroImage}
        alt="Portfolio showcase"
        class="h-full w-full object-cover"
        loading="lazy"
      />
      <div class="absolute inset-0 bg-gradient-to-b from-black/80 via-black/70 to-black/90"></div>
    </div>
    <div
      class="relative z-10 flex min-h-screen flex-col items-center justify-center px-6 text-center"
    >
      <p class="text-sm tracking-[0.5em] text-white/70 uppercase">Portfolio</p>
      <h1 class="mt-4 font-serif text-4xl leading-tight font-semibold md:text-6xl">
        Bespoke Interiors & Exteriors for the USA
      </h1>
      <p class="mt-6 max-w-3xl text-lg text-white/80">
        American-inspired interiors: handcrafted details, noble materials, and a calm palette that
        reinforces the premium residential character.
      </p>
    </div>
  </section>

  <PortfolioGallery client:load />
</Layout>
