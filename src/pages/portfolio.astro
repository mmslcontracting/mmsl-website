---
import Layout from '@/layouts/Layout.astro'
import PortfolioGallery from '@/components/PortfolioGallery'
import { Image, getImage } from 'astro:assets'
import type { ImageMetadata } from 'astro'
import CTA from '@/components/CTA.astro'
import portfolioHero from '@/assets/images/portfolio/wallpaper.jpeg'
import {
  categories,
  filters,
  galleryItems,
  type PortfolioItem,
  type PortfolioItemSource,
} from '@/data/portfolio'

const seo = {
  title: 'Portfolio',
  description:
    'View our completed renovation projects: kitchens, bathrooms, interiors & exteriors across NYC & NJ.',
  keywords: [
    'painting portfolio',
    'interior painting gallery',
    'exterior painting examples',
    'bathroom renovation',
    'commercial painting projects',
    'before after painting',
  ],
}

const requestedFilter = Astro.url.searchParams.get('filter')
const initialFilter = filters.some((filter) => filter.id === requestedFilter)
  ? requestedFilter!
  : 'all'

async function optimizePortfolioItem(item: PortfolioItemSource): Promise<PortfolioItem> {
  if (item.type === 'video') {
    const optimizedPoster = item.poster
      ? await getImage({
          src: item.poster,
          format: 'webp',
          width: Math.min(item.poster.width, 1200),
          quality: 80,
        })
      : undefined

    return {
      ...item,
      src: item.src as string,
      poster: optimizedPoster?.src,
    }
  }

  const source = item.src as ImageMetadata
  const width = Math.min(source.width, 1600)
  const height = Math.round((source.height * width) / source.width)
  const optimizedImage = await getImage({ src: source, format: 'webp', width, quality: 80 })

  return {
    ...item,
    src: optimizedImage.src,
    poster: undefined,
    width,
    height,
  }
}

const optimizedGalleryItems = await Promise.all(galleryItems.map(optimizePortfolioItem))
---

<Layout title={seo.title} description={seo.description} keywords={seo.keywords}>
  <section class="first-section relative h-[87svh] overflow-hidden bg-black text-white">
    <div class="absolute inset-0">
      <Image
        width={1200}
        height={1600}
        src={portfolioHero}
        format="webp"
        quality="high"
        alt="Portfolio showcase"
        class="h-full w-full object-cover"
        loading="eager"
        fetchpriority="high"
      />
      <div class="absolute inset-0 bg-linear-to-b from-black/70 via-black/60 to-black/80"></div>
    </div>
    <div class="relative z-10 flex h-[87svh] flex-col items-center justify-center px-6 text-center">
      <p class="text-sm tracking-[0.5em] text-white/70 uppercase">Portfolio</p>
      <h1 class="animate-fade-up mt-4 font-serif text-4xl leading-tight font-semibold md:text-6xl">
        <span class="sr-only">MMSL Contracting Corp — </span>Bespoke
        <span class="text-secondary">Interiors & Exteriors</span> for the USA
      </h1>
      <p class="mt-6 max-w-3xl text-lg text-white/80">
        American-inspired interiors: handcrafted details, noble materials, and a calm palette that
        reinforces the premium residential character.
      </p>
      <a
        href="#portfolio-gallery"
        class="border-secondary/70 bg-secondary/15 hover:bg-secondary-dark hover:border-secondary-dark group mt-8 inline-flex min-h-11 touch-manipulation items-center justify-center gap-2 rounded-full border px-6 py-3 text-sm font-semibold tracking-[0.18em] text-white uppercase shadow-lg shadow-black/20 backdrop-blur-md transition-colors hover:text-black focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2 focus-visible:ring-offset-black focus-visible:outline-none"
      >
        Explore Projects
        <svg
          aria-hidden="true"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="h-4 w-4 transition-transform group-hover:translate-y-0.5 motion-reduce:transition-none"
        >
          <path d="m6 9 6 6 6-6"></path>
        </svg>
      </a>
    </div>
  </section>

  <PortfolioGallery
    client:visible
    initialFilter={initialFilter}
    items={optimizedGalleryItems}
    categories={categories}
    filters={filters}
  />
  <CTA />
</Layout>
