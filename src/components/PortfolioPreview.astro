---
import { Image } from 'astro:assets'

const portfolioImages = [
  {
    src: '/images/portfolio/preview/exterior.jpeg',
    alt: 'Modern Exterior Remodel',
    width: 150,
    height: 300,
  },
  {
    src: '/images/portfolio/preview/bathroom2.jpeg',
    alt: 'Modern Bathroom Remodel',
    width: 300,
    height: 150,
  },
  {
    src: '/images/portfolio/preview/bathroom.jpeg',
    alt: 'Modern Bathroom Remodel',
    width: 300,
    height: 150,
  },
  {
    src: '/images/portfolio/preview/bathroom3.jpeg',
    alt: 'Modern Bathroom Remodel',
    width: 300,
    height: 150,
  },
  {
    src: '/images/portfolio/preview/living-room.jpeg',
    alt: 'Modern Living Room Remodel',
    width: 300,
    height: 150,
  },
]
---

<section class="bg-surface py-20">
  <div class="container mx-auto grid gap-4 lg:grid-cols-2">
    <div
      class="flex flex-col items-center justify-center gap-6 text-center lg:items-start lg:pr-10 lg:text-left"
    >
      <span class="inline-block text-sm font-semibold tracking-[2px] text-gradient-primary uppercase"
        >Gallery</span
      >

      <h2 class="font-serif text-4xl leading-tight font-bold text-gray-900 md:text-5xl lg:text-6xl">
        Our Portfolio
      </h2>

      <p class="text-lg leading-relaxed text-gray-600">
        Explore our portfolio of stunning renovations across New York City, North Jersey and Central Jersey. From
        modern bathrooms to contemporary living spaces, we bring your vision to life with
        exceptional craftsmanship and attention to detail.
      </p>

      <div class="mt-5 flex flex-col gap-8 sm:flex-row sm:gap-10">
        <div class="flex flex-col gap-1">
          <div class="font-serif text-4xl font-bold text-gray-900 md:text-5xl">13+</div>
          <div class="text-sm tracking-wider text-gray-600 uppercase">Years Experience</div>
        </div>
         <div class="flex flex-col gap-1">
          <div class="font-serif text-2xl font-bold text-gray-900 md:text-2xl">Many <span class="text-gradient-primary">satisfied</span> customers</div>
        </div>
      </div>

      <a
        href="/portfolio"
        class="group btn border-primary bg-primary btn-lg mt-2 gap-1 border text-white hover:bg-white hover:text-black"
      >
        View Full Portfolio
        <svg
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="1.5"
          stroke="currentColor"
          class="size-5 transition-transform duration-300 group-hover:translate-x-1"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5"></path>
        </svg>
      </a>
    </div>
    <div class="parent">
      {
        portfolioImages.map((image) => (
          <article class="child">
            <Image
              width={image.width}
              height={image.height}
              class="h-full w-full rounded-sm object-cover"
              src={image.src}
              alt={image.alt}
              loading="lazy"
            />
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .parent {
    display: grid;
    width: 100%;
    max-width: 800px;
    height: 70vh;
    max-height: 600px;
    gap: 0.5rem;
    grid-template-columns: repeat(2, 1fr);
    padding: 0.5rem;
  }

  .child {
    background-color: hsl(210, 50%, 90%);
    border-radius: 4px;
    overflow: hidden;
  }

  @media screen and (min-width: 640px) {
    .parent {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media screen and (min-width: 1024px) {
    .parent {
      grid-template-rows: 4fr 3fr 3fr;
    }
    article {
      &:nth-of-type(1) {
        grid-row: 1/3;
      }
      &:nth-of-type(2) {
        grid-row: 3/4;
      }
      &:nth-of-type(5) {
        grid-column: 2/4;
        grid-row: 2/4;
      }
    }
  }
</style>
