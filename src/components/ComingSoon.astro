---
import ComingSoonGallery from '@/components/ComingSoonGallery'
import { Image, getImage } from 'astro:assets'
import wallpaper from '@/assets/images/coming-soon/coming-soon-bg.jpeg'
import concept1 from '@/assets/images/coming-soon/1.jpeg'
import concept2 from '@/assets/images/coming-soon/2.jpeg'
import concept3 from '@/assets/images/coming-soon/3.jpeg'
import concept4 from '@/assets/images/coming-soon/4.jpeg'

const conceptSources = [concept1, concept2, concept3, concept4]
const conceptImages = await Promise.all(
  conceptSources.map(async (source, index) => {
    const optimized = await getImage({
      src: source,
      format: 'webp',
      width: Math.min(source.width, 1200),
      quality: 80,
    })
    return {
      src: optimized.src,
      width: Math.min(source.width, 1200),
      height: Math.round((source.height * Math.min(source.width, 1200)) / source.width),
      label: index < 2 ? `Concept sketch ${index + 1}` : `Concept detail ${index + 1}`,
    }
  })
)
---

<section class="relative overflow-hidden bg-black text-white">
  <div class="absolute inset-0">
    <Image
      src={wallpaper}
      format="webp"
      quality="high"
      alt="Coming soon project wallpaper"
      class="h-full w-full object-cover"
      width={1600}
      height={1200}
      loading="lazy"
    />
    <div class="absolute inset-0 bg-linear-to-b from-black/80 via-black/60 to-black/90"></div>
  </div>

  <div
    class="relative mx-auto flex min-h-[80vh] max-w-5xl flex-col items-center justify-center gap-6 px-6 py-20 text-center"
  >
    <p class="text-sm tracking-[0.8em] uppercase">
      <span class="text-gradient-gold">Coming Soon</span>
    </p>
    <h2
      class="intersect:visible intersect:animate-fade-down intersect-once intersect-full invisible font-serif text-4xl leading-tight font-semibold md:text-5xl"
    >
      <span class="text-gradient-primary">New project launching soon</span>
    </h2>
    <div class="mt-10 w-full">
      <ComingSoonGallery client:only="react" images={conceptImages} />
    </div>
  </div>
</section>
