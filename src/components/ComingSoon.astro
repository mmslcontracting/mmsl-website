---
import ComingSoonGallery from '@/components/ComingSoonGallery'
import { Image } from 'astro:assets'

const wallpaper = '/images/coming-soon/coming-soon-bg.jpeg'
---

<section class="relative overflow-hidden bg-black text-white">
  <div class="absolute inset-0">
    <Image
      src={wallpaper}
      alt="Coming soon project wallpaper"
      class="h-full w-full object-cover"
      width={1600}
      height={1200}
      loading="lazy"
    />
    <div class="absolute inset-0 bg-linear-to-b from-black/80 via-black/60 to-black/90"></div>
  </div>

  <div
    class="relative mx-auto flex min-h-[80vh] max-w-5xl flex-col items-center justify-center gap-6 px-6 py-20 text-center"
  >
    <p class="text-sm tracking-[0.8em] uppercase">
      <span class="text-gradient-primary">Coming Soon</span>
    </p>
    <h2
      class="intersect:visible intersect:animate-fade-down intersect-once intersect-full invisible font-serif text-4xl leading-tight font-semibold md:text-5xl"
    >
      New project launching soon
    </h2>
    <div class="mt-10 w-full">
      <ComingSoonGallery client:load />
    </div>
  </div>
</section>
