---
import ComingSoonGallery from '@/components/ComingSoonGallery'
import { Image } from 'astro:assets';

const wallpaper = '/images/coming-soon/coming-soon-bg.jpeg'
const heroText = 'New project launching soon'
;('An immersive residential concept redefining coastal living with refined materials, layered lighting, and custom millwork.')
---

<section class="relative overflow-hidden bg-black text-white">
  <div class="absolute inset-0">
    <Image
      src={wallpaper}
      alt="Coming soon project wallpaper"
      class="h-full w-full object-cover"
      width={1600}
      height={1200}
      loading="lazy"
    />
    <div class="absolute inset-0 bg-linear-to-b from-black/80 via-black/60 to-black/90"></div>
  </div>

  <div
    class="relative mx-auto flex min-h-[80vh] max-w-5xl flex-col items-center justify-center gap-6 px-6 py-20 text-center"
  >
    <p class="text-gradient-primary text-sm tracking-[0.8em] uppercase">Coming Soon</p>
    <h2 class="font-serif text-4xl leading-tight font-semibold md:text-5xl">{heroText}</h2>
    <div class="mt-10 w-full">
      <ComingSoonGallery client:load />
    </div>
  </div>
</section>
