---
import { Image } from 'astro:assets'
import drywallImg from '@/assets/images/portfolio/lafayette-residence-nyc/lafayette-living-room-city-windows.jpg'
import paintingImg from '@/assets/images/portfolio/interior/2.jpeg'
import kitchenImg from '@/assets/images/portfolio/lafayette-residence-nyc/lafayette-open-plan-kitchen-dining.jpg'
import bathroomImg from '@/assets/images/portfolio/park-slope-brooklyn-ny/park-slope-bathroom-patterned-tile-floor.jpeg'
import woodImg from '@/assets/images/portfolio/exterior/2b435148-b141-4bdd-baa4-43cea22e3751.jpeg'
import floorImg from '@/assets/images/portfolio/great-neck-ny/great-neck-bedroom-hardwood-floor.jpeg'
import decksImg from '@/assets/images/portfolio/exterior/3.jpeg'
import fencesImg from '@/assets/images/portfolio/exterior/1.jpeg'
import carpentryImg from '@/assets/images/portfolio/lafayette-residence-nyc/lafayette-dining-room-divider.jpg'
import basementImg from '@/assets/images/portfolio/interior/1.jpeg'

const services = [
  {
    src: drywallImg,
    alt: 'Smooth plaster walls and ceiling beams finished by MMSL Contracting Corp',
    title: 'Drywall & Plastering',
    copy: 'Expert drywall and plaster installation and repair for smooth, flawless walls and ceilings.',
  },
  {
    src: paintingImg,
    alt: 'Living room with fresh terracotta paint and white trim by MMSL Contracting Corp',
    title: 'Painting and wallpaper installation',
    copy: 'Professional interior and exterior painting for a fresh, vibrant look.',
  },
  {
    src: kitchenImg,
    alt: 'Custom kitchen with walnut millwork remodeled by MMSL Contracting Corp',
    title: 'Kitchen Remodeling',
    copy: 'Transform your kitchen with modern designs, new cabinetry, and updated finishes.',
  },
  {
    src: bathroomImg,
    alt: 'Renovated bathroom with subway tile and geometric floor by MMSL Contracting Corp',
    title: 'Bathroom Renovation',
    copy: 'Upgrade your bathroom for comfort, style, and improved functionality.',
  },
  {
    src: woodImg,
    alt: 'Restored historic wood entry door by MMSL Contracting Corp',
    title: 'Expert Wood Restoration',
    copy: 'Restoring and preserving wood features to their original beauty and strength.',
  },
  {
    src: floorImg,
    alt: 'Newly installed hardwood floor by MMSL Contracting Corp',
    title: 'Hardwood Floor & Tile Installation',
    copy: 'Professional installation of hardwood floors and tiles for lasting quality.',
  },
  {
    src: decksImg,
    alt: 'Newly built cedar deck by MMSL Contracting Corp',
    title: 'Decks',
    copy: 'Custom deck design and construction for outdoor living spaces.',
  },
  {
    src: fencesImg,
    alt: 'Finished brownstone entry and stoop by MMSL Contracting Corp',
    title: 'Fences',
    copy: 'Installation and repair of fences for privacy and security.',
  },
  {
    src: carpentryImg,
    alt: 'Custom wood and glass room divider built by MMSL Contracting Corp',
    title: 'Carpentry',
    copy: 'Carpentry solutions for interiors and exteriors.',
  },
  {
    src: basementImg,
    alt: 'Finished living space with detailed millwork by MMSL Contracting Corp',
    title: 'Basement',
    copy: 'Basement finishing and remodeling for added living space and value.',
  },
]
---

<section id="services" class="bg-white py-20">
  <div class="container mx-auto">
    <div class="mb-12 text-center">
      <h2 class="mb-6 font-serif text-4xl font-semibold">Our Services</h2>
      <p class="text-text-secondary mx-auto max-w-2xl text-lg">Completely Interior Renovation</p>
    </div>

    <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-4">
      {
        services.map((service) => (
          <div class="group intersect:visible intersect:animate-fade-up intersect-once intersect-full animate-delay-100 animate-duration-[1.5s] invisible overflow-hidden rounded-2xl border border-gray-100 bg-white text-center shadow-sm transition duration-300 hover:-translate-y-1 hover:shadow-xl">
            <div class="overflow-hidden">
              <Image
                src={service.src}
                alt={service.alt}
                width={600}
                height={400}
                class="h-44 w-full object-cover transition duration-500 group-hover:scale-105"
                loading="lazy"
              />
            </div>
            <div class="p-5">
              <h3 class="mb-3 text-xl font-semibold">{service.title}</h3>
              <p class="text-text-secondary text-sm leading-relaxed">{service.copy}</p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
