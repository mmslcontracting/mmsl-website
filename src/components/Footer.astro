---
const logoSrc = '/images/mmspaint_logo.jpeg';
---

<footer class="bg-black text-white">
  <div class="max-w-7xl mx-auto px-6 py-16">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
      <div class="md:col-span-1">
        <a href="/" class="flex items-center gap-3">
          <img src={logoSrc} alt="MMS logo" class="h-10 w-auto rounded-none" />
        </a>
        <p class="mt-4 text-white/85 text-sm max-w-xs">MMS Home Paint — Interior design & build across New Jersey, Boston & New York.</p>
      </div>

      <div>
        <h4 class="font-serif text-lg text-white">Services</h4>
        <ul class="mt-4 space-y-2 text-sm text-white/80">
          <li><a href="#" class="hover:underline">Painting</a></li>
          <li><a href="#" class="hover:underline">Kitchen Renovation</a></li>
          <li><a href="#" class="hover:underline">Bathroom Renovation</a></li>
          <li><a href="#" class="hover:underline">Flooring & Tile</a></li>
        </ul>
      </div>

      <div>
        <h4 class="font-serif text-lg text-white">Company</h4>
        <ul class="mt-4 space-y-2 text-sm text-white/80">
          <li><a href="#" class="hover:underline">About</a></li>
          <li><a href="#" class="hover:underline">Projects</a></li>
          <li><a href="#" class="hover:underline">Services</a></li>
          <li><a href="#" class="hover:underline">Contact</a></li>
        </ul>
      </div>

      <div>
        <h4 class="font-serif text-lg text-white">Contact</h4>
        <address class="not-italic mt-4 text-sm text-white/80">
          <div>Phone: <a href="tel:+1-555-555-5555" class="hover:underline">(555) 555-5555</a></div>
          <div class="mt-2">Email: <a href="mailto:hello@mms.com" class="hover:underline">hello@mms.com</a></div>
          <div class="mt-4 flex gap-3">
            <!-- Simple social SVGs -->
            <a href="#" aria-label="Twitter" class="text-white/80 hover:text-white">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24"><path d="M22 5.92c-.66.29-1.37.48-2.12.57.76-.45 1.34-1.16 1.61-2.01-.71.42-1.5.72-2.34.88C18.49 4.2 17.26 3.5 15.9 3.5c-2.5 0-4.52 2.31-3.95 4.74C9.72 8 7.1 6.6 5.3 4.6c-.86 1.49-.38 3.41 1.13 4.38-.57-.02-1.13-.17-1.61-.43v.04c0 1.98 1.38 3.64 3.21 4.01-.5.14-1.03.2-1.56.08.44 1.43 1.72 2.48 3.23 2.51-1.19.92-2.66 1.37-4.19 1.29 1.36.86 2.97 1.36 4.69 1.36 5.63 0 8.72-4.84 8.72-9.04v-.41c.6-.44 1.12-1 1.53-1.63-.56.25-1.16.41-1.78.48z"/></svg>
            </a>
            <a href="#" aria-label="Instagram" class="text-white/80 hover:text-white">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24"><path d="M7 2h10a5 5 0 015 5v10a5 5 0 01-5 5H7a5 5 0 01-5-5V7a5 5 0 015-5zm5 6.2A3.8 3.8 0 1015.8 12 3.8 3.8 0 0012 8.2zm6.4-3.7a1.1 1.1 0 11-1.1 1.1 1.1 1.1 0 011.1-1.1z"/></svg>
            </a>
          </div>
        </address>
      </div>
    </div>
    <div class="mt-8 text-center text-sm text-white/70">© {new Date().getFullYear()} MMS Home Paint. All rights reserved.</div>
  </div>
</footer>
