---
import { Image } from 'astro:assets'

const heroImg = '/images/coming-soon/wallpaper.jpeg'
---

<section class="first-section relative flex min-h-[87svh] flex-col justify-center overflow-hidden">
  <div class="absolute inset-0 -z-10 h-full w-full">
    <Image
      width={1200}
      height={1600}
      src={heroImg}
      alt="Hero background"
      class="h-full w-full object-cover"
    />
    <div class="absolute inset-0 bg-black opacity-75"></div>
  </div>

  <div class="relative z-10 container mx-auto">
    <div class="">
      <p class="mb-4 text-sm text-white/80">New York City · North Jersey · Central Jersey</p>
      <h1 class="text-5xl text-white md:text-6xl lg:text-[80px]">
        Improve / <span class="text-gradient-primary">Transform</span><br />your space
      </h1>

      <p class="mt-8 max-w-md text-white/90">
        Reliable craftsmen known for extraordinary attention to detail and pragmatic
        troubleshooting. <br />

        The mind creates the beautiful, the heart creates the home, home sweet home.
      </p>

      <div class="mt-8 flex gap-4">
        <a href="/contact" class="btn-primary btn-lg">Start Project</a>
        <a
          href="#recentProject"
          class="btn btn-lg border border-white text-white backdrop-blur-sm transition hover:bg-white hover:text-black"
          >Learn More</a
        >
      </div>
    </div>
  </div>
</section>
