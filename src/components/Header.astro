---
import { Image } from 'astro:assets'
import MobileNav from './MobileNav'

const logoSrc = '/images/logo.jpg'
---

<header class="fixed top-0 z-50 grid h-[13vh] w-screen place-items-center bg-white shadow-sm">
  <div class="container mx-auto flex items-center justify-between">
    <a href="/" class="flex items-center gap-3">
      <Image
        width={150}
        height={50}
        src={logoSrc}
        alt="MMSL Contracting logo"
        class="h-8 w-auto rounded-none md:h-14"
      />
    </a>

    <nav
      class="hidden gap-10 text-base font-medium text-gray-700 md:flex"
      aria-label="Main navigation"
    >
      <a href="/" class="hover:underline">Home</a>
      <a href="/about" class="hover:underline">About</a>
      <a href="/#services" class="hover:underline">Services</a>
      <a href="/portfolio" class="hover:underline">Portfolio</a>
      <a href="/contact" class="hover:underline">Contact</a>
    </nav>

    <div class="hidden items-center gap-6 md:flex">
      <a href="/contact" class="btn-primary btn-base">Get Quote</a>
    </div>

    <!-- Mobile Navigation -->
    <MobileNav client:load />
  </div>
</header>
