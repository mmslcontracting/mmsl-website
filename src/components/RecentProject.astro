---
import { Image } from "astro:assets";
---

<section id="recentProject" class="bg-surface py-12 lg:py-20">
  <div class="container mx-auto">
    <div class="mb-12 text-center">
      <h2 class="mb-6 font-serif text-4xl font-semibold">Recent Renovations</h2>
      <p class="text-text-secondary mx-auto max-w-2xl text-lg">
        We specialize in transforming your space into a comfortable place, by creating memories with
        every improvement to your home renovations or new projects.
      </p>
    </div>

    <div class="grid items-center gap-12 lg:grid-cols-2">
      <!-- Project Showcase -->
      <div class="relative">
        <div class="grid grid-cols-2 gap-4">
          <div class="space-y-4">
            <Image
              width={600}
              height={800}
              src="/images/recent-project/bathroom.jpeg"
              alt="Modern bathroom renovation with sleek fixtures and minimalist design"
              class="shadow-card h-48 w-full rounded-lg object-cover"
            />
            <Image
              width={600}
              height={800}
              src="/images/recent-project/bathroom2.jpeg"
              alt="Modern bathroom renovation with sleek fixtures and minimalist design"
              class="shadow-card h-32 w-full rounded-lg object-cover"
            />
          </div>
          <div class="mt-8 space-y-4">
            <Image
              width={600}
              height={800}
              src="/images/recent-project/bathroom3.jpeg"
              alt="Modern bathroom renovation with sleek fixtures and minimalist design"
              class="shadow-card h-32 w-full rounded-lg object-cover"
            />
            <Image
              width={600}
              height={800}
              src="/images/recent-project/living-room.jpeg"
              alt="Modern living room with sleek furniture and ambient lighting"
              class="shadow-card h-32 w-full rounded-lg object-cover"
            />
          </div>
        </div>
      </div>

      <!-- Project Details -->
      <div>
        <div class="mb-8">
          <p class="text-text-secondary mb-6 leading-relaxed">
            We adapt each space to the needs and preferences of our clients to achieve modern,
            comfortable and functional environments.
          </p>

          <div class="mb-8 space-y-4">
            <div class="flex items-center">
              <svg class="text-primary mr-3 h-5 w-5" fill="currentColor" viewBox="0 0 20 20">
                <path
                  fill-rule="evenodd"
                  d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                  clip-rule="evenodd"></path>
              </svg>
              <span class="text-text-secondary">Complete bathroom remodels</span>
            </div>
            <div class="flex items-center">
              <svg class="text-primary mr-3 h-5 w-5" fill="currentColor" viewBox="0 0 20 20">
                <path
                  fill-rule="evenodd"
                  d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                  clip-rule="evenodd"></path>
              </svg>
              <span class="text-text-secondary">Upgrading finishes and fixtures</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
